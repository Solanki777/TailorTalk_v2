# FastAPI config
PORT=8000
HOST=127.0.0.1
DEBUG=True

# Security & Keys
# Recommended (free, no billing card required): get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Optional fallback, only used if GROQ_API_KEY is not set
GEMINI_API_KEY=your_gemini_api_key_here

# Storage config
UPLOAD_DIR=storage/uploads
MAX_FILE_SIZE_MB=50
